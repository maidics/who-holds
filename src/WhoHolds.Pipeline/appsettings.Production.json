{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "System": "Information",
      "Microsoft": "Information"
    }
  },
  "Pipeline": {
    "Configuration": "Release",
    "GitHubTagRef": "tag"
  },
  "CppBuildTool": {
    "VsWhereSubdirectory": "Microsoft Visual Studio/Installer",
    "VsWhere": "vswhere.exe",
    "VsWhereArguments": [
      "-latest",
      "-products",
      "*",
      "-requires",
      "Microsoft.VisualStudio.Component.VC.Tools.x86.x64",
      "-property",
      "installationPath"
    ]
  },
  "Publish": {
    "ProjectPath": "src/WhoHolds.Cli/WhoHolds.Cli.csproj",
    "Runtime": "win-x64",
    "OutputDirectory": "artifacts/publish"
  }
}
